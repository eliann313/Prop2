# Copiá este archivo a .env y completá los valores. NO commitees el .env (13.2, 8.9).
#
# Solo las dos primeras variables son obligatorias: con la base y el secreto de Auth.js la app
# levanta y los flujos de registro / verificación / login / recuperación se pueden probar de
# punta a punta. Google, Resend y Upstash degradan con gracia cuando faltan (ver más abajo).

# ─── Base de datos (Neon) — OBLIGATORIA ────────────────────────────────────────
# Pooled: la usa el runtime de la app. Es la URL que muestra Neon por defecto.
DATABASE_URL=
# Direct (la misma URL sin el "-pooler" en el host): la usan las migraciones y el seed.
# El pooler de Neon no soporta las sentencias del motor de migraciones.
DATABASE_URL_UNPOOLED=

# ─── Auth.js — OBLIGATORIA ─────────────────────────────────────────────────────
# Generala con: npx auth secret
AUTH_SECRET=
# En local, http://localhost:3000. En Vercel se puede omitir: se deduce del deployment.
AUTH_URL=http://localhost:3000

# ─── Google OAuth — opcional ───────────────────────────────────────────────────
# Sin estas dos, el botón "Continuar con Google" no se muestra y el resto sigue funcionando.
# Se sacan de un proyecto de Google Cloud > Credenciales > ID de cliente de OAuth.
# URI de redirección autorizada: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Resend (emails) — opcional en desarrollo ──────────────────────────────────
# Sin RESEND_API_KEY, los links de verificación y de reseteo se IMPRIMEN en la consola del
# servidor en vez de enviarse por email. Alcanza para probar los flujos sin dar de alta Resend.
# En producción sí hace falta.
RESEND_API_KEY=
EMAIL_FROM=Prop² <onboarding@resend.dev>

# ─── Upstash Redis (rate limiting) — opcional en desarrollo ────────────────────
# Sin estas dos, el rate limiting de login, registro y envío de emails queda INACTIVO (permite
# todo) y el servidor lo avisa por consola al arrancar en producción. En producción son
# necesarias: son lo que frena fuerza bruta y el agotamiento de la cuota de emails (8.4).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Cloudinary (fotos de las publicaciones) — opcional en desarrollo ──────────
# Sin estas tres, el paso de fotos del wizard queda deshabilitado: se pueden crear y editar
# borradores, pero no pasarlos a "activa" (publicar exige al menos una foto).
# Se sacan del Dashboard de Cloudinary > Settings > API Keys.
#
# El cloud name es público: viaja en la URL de cada imagen. El secret NO sale del servidor —
# se usa solo para firmar cada subida, y el navegador recibe la firma, nunca la clave.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Cron de limpieza ─────────────────────────────────────────────────────────
# Autoriza los endpoints de /api/cron. En Vercel se declara en el proyecto y el scheduler la
# manda como `Authorization: Bearer <valor>`.
# Sin esta variable el endpoint RECHAZA todo, incluso en local: es a propósito, porque un
# endpoint que borra archivos y además es público sería un botón de "vaciame Cloudinary".
# Generala con: openssl rand -base64 32
CRON_SECRET=
